# Copy this file to .env and fill in real local values.
# .env itself is git-ignored and never committed.

DB_PASSWORD=your_local_postgres_password
JWT_SECRET=your_jwt_signing_secret

# Shared secret ai-service/notification-service present as the
# X-Internal-Service-Key header when calling another service's
# /internal/** endpoints directly (bypassing the gateway/JWT).
INTERNAL_SERVICE_KEY=your_internal_service_key

# ai-service -> OpenAI Responses API
OPENAI_API_KEY=your_openai_api_key

# notification-service -> outgoing email (Gmail SMTP example).
# Use a Gmail App Password, never your real account password.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
